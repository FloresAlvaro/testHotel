{
  "SessionUser": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 200
      },
      "role": {
        "type": "string",
        "enum": [
          "admin",
          "manager",
          "receptionist",
          "customer"
        ]
      },
      "client_id": {
        "type": "integer",
        "nullable": true
      },
      "is_active": {
        "type": "boolean"
      },
      "created_at": {
        "type": "string"
      },
      "updated_at": {
        "type": "string"
      },
      "auth_version": {
        "type": "integer"
      },
      "client_active": {
        "type": "boolean",
        "nullable": true
      }
    },
    "required": [
      "id",
      "name",
      "email",
      "role",
      "is_active",
      "created_at",
      "updated_at"
    ]
  },
  "SessionLoginInput": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 200,
        "x-trim": true
      },
      "password": {
        "type": "string",
        "minLength": 8,
        "maxLength": 72,
        "x-maxBytes": 72,
        "description": "M\u00ednimo 8 caracteres y m\u00e1ximo 72 bytes UTF-8"
      }
    },
    "required": [
      "email",
      "password"
    ]
  },
  "SessionData": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "user": {
        "$ref": "#/components/schemas/SessionUser"
      },
      "csrfToken": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "user",
      "csrfToken"
    ]
  },
  "SessionResponse": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "success": {
        "type": "boolean",
        "enum": [
          true
        ]
      },
      "data": {
        "$ref": "#/components/schemas/SessionData"
      },
      "message": {
        "type": "string"
      },
      "timestamp": {
        "type": "string"
      }
    },
    "required": [
      "success",
      "data"
    ]
  },
  "StaffInvitationInput": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200,
        "x-trim": true
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 200,
        "x-trim": true,
        "x-lowercase": true
      },
      "role": {
        "type": "string",
        "enum": [
          "admin",
          "manager",
          "receptionist"
        ]
      }
    },
    "required": [
      "name",
      "email",
      "role"
    ]
  },
  "CustomerInvitationInput": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200,
        "x-trim": true
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 200,
        "x-trim": true,
        "x-lowercase": true
      },
      "role": {
        "type": "string",
        "enum": [
          "customer"
        ]
      },
      "client_id": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "name",
      "email",
      "role",
      "client_id"
    ]
  },
  "InvitationInput": {
    "anyOf": [
      {
        "$ref": "#/components/schemas/StaffInvitationInput"
      },
      {
        "$ref": "#/components/schemas/CustomerInvitationInput"
      }
    ]
  },
  "AcceptInvitationInput": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "token": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      },
      "password": {
        "type": "string",
        "minLength": 8,
        "maxLength": 72,
        "x-maxBytes": 72,
        "description": "M\u00ednimo 8 caracteres y m\u00e1ximo 72 bytes UTF-8",
        "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9]).*$"
      }
    },
    "required": [
      "token",
      "password"
    ]
  },
  "Invitation": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 200
      },
      "role": {
        "type": "string",
        "enum": [
          "admin",
          "manager",
          "receptionist",
          "customer"
        ]
      },
      "client_id": {
        "type": "integer",
        "nullable": true
      },
      "created_at": {
        "type": "string"
      },
      "expires_at": {
        "type": "string"
      },
      "used_at": {
        "type": "string",
        "nullable": true
      }
    },
    "required": [
      "id",
      "name",
      "email",
      "role",
      "expires_at"
    ]
  },
  "InvitationResponse": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "success": {
        "type": "boolean",
        "enum": [
          true
        ]
      },
      "data": {
        "$ref": "#/components/schemas/Invitation"
      },
      "message": {
        "type": "string"
      }
    },
    "required": [
      "success",
      "data"
    ]
  },
  "BackupStatus": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "latest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "verified_at": {
            "type": "string"
          },
          "archive": {
            "type": "string"
          },
          "restored": {
            "type": "boolean"
          },
          "offsite_verified": {
            "type": "boolean"
          }
        },
        "required": [
          "verified_at",
          "archive",
          "restored"
        ],
        "nullable": true
      },
      "status": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "attempted_at": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "attempted_at"
        ],
        "nullable": true
      },
      "storage": {
        "type": "string"
      },
      "offsite_configured": {
        "type": "boolean"
      }
    },
    "required": [
      "latest",
      "status",
      "storage",
      "offsite_configured"
    ]
  },
  "PaymentListSummary": {
    "type": "object",
    "required": [
      "total",
      "income",
      "pending",
      "refunds",
      "completed_count",
      "pending_count",
      "refunded_count",
      "max_income"
    ],
    "properties": {
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "completed_count": {
        "type": "integer",
        "minimum": 0
      },
      "pending_count": {
        "type": "integer",
        "minimum": 0
      },
      "refunded_count": {
        "type": "integer",
        "minimum": 0
      },
      "income": {
        "type": "string",
        "description": "Importe decimal exacto en la moneda del hotel"
      },
      "pending": {
        "type": "string",
        "description": "Importe decimal exacto en la moneda del hotel"
      },
      "refunds": {
        "type": "string",
        "description": "Importe decimal exacto en la moneda del hotel"
      },
      "max_income": {
        "type": "string",
        "description": "Importe decimal exacto en la moneda del hotel"
      }
    }
  },
  "OwnSession": {
    "type": "object",
    "required": [
      "id",
      "created_at",
      "expires_at",
      "current"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "expires_at": {
        "type": "string",
        "format": "date-time"
      },
      "current": {
        "type": "boolean"
      }
    }
  },
  "OwnSessionsResponse": {
    "type": "object",
    "required": [
      "success",
      "data"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/OwnSession"
        }
      }
    }
  },
  "MfaChallengeResponse": {
    "type": "object",
    "required": [
      "success",
      "data"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "required": [
          "mfaRequired",
          "challengeId",
          "enrollmentRequired"
        ],
        "properties": {
          "mfaRequired": {
            "type": "boolean"
          },
          "challengeId": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "enrollmentRequired": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "MfaEnrollmentResponse": {
    "type": "object",
    "required": [
      "success",
      "data"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "required": [
          "secret",
          "uri",
          "recoveryCodes"
        ],
        "properties": {
          "secret": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "recoveryCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "MfaStatusResponse": {
    "type": "object",
    "required": [
      "success",
      "data"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "required": [
          "enabled",
          "required",
          "recoveryCodesRemaining"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "recoveryCodesRemaining": {
            "type": "integer"
          }
        }
      }
    }
  },
  "MfaChallengeInput": {
    "type": "object",
    "required": [
      "challengeId"
    ],
    "properties": {
      "challengeId": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "MfaVerifyInput": {
    "type": "object",
    "required": [
      "challengeId",
      "code"
    ],
    "properties": {
      "challengeId": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "code": {
        "type": "string",
        "pattern": "^(?:[0-9]{6}|[a-f0-9]{16})$"
      }
    }
  },
  "MfaConfirmInput": {
    "type": "object",
    "required": [
      "challengeId",
      "code",
      "recoveryCodesSaved"
    ],
    "properties": {
      "challengeId": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "code": {
        "type": "string",
        "pattern": "^[0-9]{6}$"
      },
      "recoveryCodesSaved": {
        "type": "boolean",
        "enum": [
          true
        ]
      }
    }
  },
  "MfaRenewInput": {
    "type": "object",
    "required": [
      "password",
      "code"
    ],
    "properties": {
      "password": {
        "type": "string",
        "minLength": 8,
        "maxLength": 72
      },
      "code": {
        "type": "string",
        "pattern": "^(?:[0-9]{6}|[a-f0-9]{16})$"
      }
    }
  },
  "BearerLoginResponse": {
    "type": "object",
    "required": [
      "success",
      "data"
    ],
    "properties": {
      "success": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "required": [
          "user",
          "token"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "token": {
            "type": "string"
          }
        }
      }
    }
  },
  "MfaCompletionResponse": {
    "anyOf": [
      {
        "$ref": "#/components/schemas/SessionResponse"
      },
      {
        "$ref": "#/components/schemas/BearerLoginResponse"
      }
    ]
  },
  "MfaEnableInput": {
    "type": "object",
    "required": [
      "password"
    ],
    "properties": {
      "password": {
        "type": "string",
        "minLength": 8,
        "maxLength": 72
      }
    }
  }
}
