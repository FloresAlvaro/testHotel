# ============================================
# CONFIGURACIÓN BÁSICA
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL=postgresql://hotel_runtime:replace-with-runtime-password@localhost:5432/hotel_db
# Solo para db:migrate; no pasar esta variable al servicio HTTP.
MIGRATION_DATABASE_URL=postgresql://hotel_migrator:replace-with-migrator-password@localhost:5432/hotel_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=2000

# ============================================
# AUTENTICACIÓN
# ============================================
JWT_SECRET=tu-clave-secreta-muy-larga-de-al-menos-32-caracteres
JWT_EXPIRE=24h
BCRYPT_ROUNDS=10
SESSION_SECRET=tu-session-secret
SESSION_MAX_AGE=86400000
MFA_ENABLED=true
# 32 bytes aleatorios en hexadecimal. Conservar fuera de la BD y de sus dumps.
MFA_ENCRYPTION_KEY=replace-with-generated-32-byte-hex-key
SECURITY_RETENTION_ENABLED=true
SECURITY_SESSION_RETENTION_DAYS=7
SECURITY_LINK_RETENTION_HOURS=24

# ============================================
# SEGURIDAD Y CORS
# ============================================
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=combined

# ============================================
# ARCHIVOS
# ============================================
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/jpg

# ============================================
# EMAIL (Opcional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-contraseña-app
SMTP_FROM=noreply@hotel.com

# ============================================
# PAGOS (Opcional)
# ============================================
PAYMENT_API_KEY=tu-api-key-aqui
PAYMENT_API_URL=https://api.payment-provider.com

# ============================================
# MONITOREO
# ============================================
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=60000
# Integraciones del template: mantener secretos fuera del repositorio.
APP_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# disabled | stripe; demo solo con ALLOW_DEMO_PAYMENTS=true (Compose demo).
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCIES=USD,EUR

# Solo proxies explícitos, por ejemplo loopback o 10.0.0.5/32. Vacío: conexión directa.
TRUST_PROXY=
SHUTDOWN_TIMEOUT_MS=30000
