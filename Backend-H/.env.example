# ============================================
# CONFIGURACIÓN BÁSICA
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/hotel_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=2000

# ============================================
# AUTENTICACIÓN
# ============================================
JWT_SECRET=tu-clave-secreta-muy-larga-de-al-menos-32-caracteres
JWT_EXPIRE=24h
BCRYPT_ROUNDS=10
SESSION_SECRET=tu-session-secret
SESSION_MAX_AGE=86400000

# ============================================
# SEGURIDAD Y CORS
# ============================================
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=combined

# ============================================
# ARCHIVOS
# ============================================
MAX_FILE_SIZE=5242880
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/jpg

# ============================================
# EMAIL (Opcional)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hotel.com

# ============================================
# PAGOS (Opcional)
# ============================================
PAYMENT_API_KEY=tu-api-key-aqui
PAYMENT_API_URL=https://api.payment-provider.com

# ============================================
# MONITOREO
# ============================================
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=60000
FRONTEND_URL=http://localhost:3001
# COOKIE_SECURE se infiere de FRONTEND_URL (HTTPS).
SMTP_SECURE=false
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_DELAY_MS=500
AUTH_RETENTION_DAYS=30
AUTH_CLEANUP_INTERVAL_MS=3600000
# Solo IPs/subredes de proxies conocidos; vacío si no hay proxy.
TRUST_PROXY=
# Opciones para npm run backup y npm run backup:watch
BACKUP_CONTAINER=hotel-db
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=14
# BACKUP_DIRECTORY=C:/backups/hotel
# BACKUP_MIRROR_DIRECTORY=Z:/backups/hotel
