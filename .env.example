POSTGRES_DB=hotel_db
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432
# Roles separados. Genera cuatro valores aleatorios distintos (hexadecimal/URL-safe).
# POSTGRES_USER/PASSWORD quedan solo para inicialización/recuperación administrativa.
POSTGRES_RUNTIME_PASSWORD=replace-with-generated-runtime-password
POSTGRES_MIGRATOR_PASSWORD=replace-with-generated-migrator-password
POSTGRES_BACKUP_PASSWORD=replace-with-generated-backup-password
POSTGRES_VERIFY_PASSWORD=replace-with-generated-verification-password
MFA_ENCRYPTION_KEY=replace-with-generated-32-byte-hex-key
MFA_ENABLED=true
SECURITY_RETENTION_ENABLED=true
SECURITY_SESSION_RETENTION_DAYS=7
SECURITY_LINK_RETENTION_HOURS=24
BACKEND_PORT=3000
JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_EXPIRE=24h
BCRYPT_ROUNDS=10
CORS_CREDENTIALS=true
FRONTEND_PORT=3001

APP_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCIES=USD,EUR
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Solo proxies explícitos, por ejemplo loopback o 10.0.0.5/32. Vacío: conexión directa.
TRUST_PROXY=
SHUTDOWN_TIMEOUT_MS=30000

# Duración fija de la sesión del navegador en milisegundos (24 horas).
SESSION_MAX_AGE=86400000

# Para copias fuera del servidor, usa docker-compose.offsite.yml y un montaje remoto existente.
# BACKUP_OFFSITE_PATH=/ruta/a/montaje-remoto/hotel
