POSTGRES_DB=hotel_db
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432
BACKEND_PORT=3000
JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_EXPIRE=24h
BCRYPT_ROUNDS=10
CORS_CREDENTIALS=true
FRONTEND_PORT=3001

# Acceso remoto: configura la URL publica de API y el origen del frontend.
# NUXT_PUBLIC_API_BASE=https://api.example.com/api
# CORS_ORIGIN=https://hotel.example.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=60000
# Debe coincidir con el origen público configurado en CORS_ORIGIN.
# FRONTEND_URL=https://hotel.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hotel.com
SMTP_SECURE=false
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_DELAY_MS=500
AUTH_RETENTION_DAYS=30
AUTH_CLEANUP_INTERVAL_MS=3600000
TRUST_PROXY=
BACKUP_CONTAINER=hotel-db
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=14
# BACKUP_MIRROR_DIRECTORY=Z:/backups/hotel
