POSTGRES_DB=hotel_db
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432
BACKEND_PORT=3000
JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_EXPIRE=24h
BCRYPT_ROUNDS=10
CORS_CREDENTIALS=true
FRONTEND_PORT=3001

# Acceso remoto: configura la URL publica de API y el origen del frontend.
# NUXT_PUBLIC_API_BASE=https://api.example.com/api
# CORS_ORIGIN=https://hotel.example.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=60000
